# Copy this file to .env and fill in real values.
# Never commit .env.

# Supabase project credentials (https://app.supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-secret-key

# Random 32-byte hex string used as a seed for AES key derivation.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RANDOM_AES_SEED=

# DEVELOPMENT | STAGING | PRODUCTION
ENVIRONMENT=DEVELOPMENT

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# Test user credentials, only used when ENVIRONMENT=DEVELOPMENT
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test01!

# URL of the frontend web app, used for links emitted by the backend
WEBAPP_URL=http://localhost:3000

# Auto-populated by run.sh on macOS/Linux/Windows; safe to leave blank
NEXT_PUBLIC_LOCAL_IP=
